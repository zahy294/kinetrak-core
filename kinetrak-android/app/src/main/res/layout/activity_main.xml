<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black">

    <!-- Full-screen CameraX PreviewView -->
    <androidx.camera.view.PreviewView
        android:id="@+id/viewFinder"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Top Status Bar & State Indicator Badge -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardStateBadge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:layout_marginEnd="16dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="6dp"
        app:cardBackgroundColor="@color/badge_idle_cyan"
        app:strokeColor="#80FFFFFF"
        app:strokeWidth="1dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp">

            <View
                android:id="@+id/viewStateDot"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/ic_mic"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvStateBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="STATE: IDLE"
                android:textColor="@color/black"
                android:textSize="13sp"
                android:textStyle="bold"
                android:letterSpacing="0.05"
                tools:text="STATE: IDLE" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- High-Contrast HUD Overlay Card -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardHud"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="24dp"
        android:layout_marginEnd="12dp"
        app:cardCornerRadius="12dp"
        app:cardElevation="8dp"
        app:cardBackgroundColor="@color/hud_background"
        app:strokeColor="@color/hud_border"
        app:strokeWidth="1.5dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/cardStateBadge">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="KINETRAK TELEMETRY"
                android:textColor="@color/hud_text_accent"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.1" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="6dp"
                android:background="@color/hud_border" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvHudSeq"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="SEQ: 1"
                    android:textColor="@color/hud_text_primary"
                    android:textSize="14sp"
                    android:typeface="monospace"
                    android:textStyle="bold"
                    tools:text="SEQ: 1245" />

                <TextView
                    android:id="@+id/tvHudTracking"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="TRACKING: 1"
                    android:textColor="@color/hud_tracking_on"
                    android:textSize="14sp"
                    android:typeface="monospace"
                    android:textStyle="bold"
                    tools:text="TRACKING: 1" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvHudPose"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="POS: [0.00, 0.00, 0.00]"
                android:textColor="@color/hud_text_secondary"
                android:textSize="11sp"
                android:typeface="monospace"
                tools:text="POS: [+0.12, -0.45, +0.89]" />

            <TextView
                android:id="@+id/tvHudAction"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="ACTION: NULL"
                android:textColor="@color/hud_text_secondary"
                android:textSize="11sp"
                android:typeface="monospace"
                tools:text="ACTION: NULL" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Bottom Controls Area -->
    <LinearLayout
        android:id="@+id/bottomControlsContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="28dp"
        android:gravity="center_vertical|end"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Mic Toggle Floating Action Button (Voice Trigger) -->
        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fabMicToggle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="12dp"
            android:contentDescription="Voice Trigger Toggle"
            android:src="@drawable/ic_mic"
            app:backgroundTint="@color/fab_mic_idle"
            app:tint="@color/white"
            app:fabSize="normal"
            app:elevation="8dp" />

        <!-- Export Trajectory Extended Floating Action Button -->
        <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
            android:id="@+id/fabExport"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="EXPORT TRAJECTORY"
            android:textColor="@color/fab_export_text"
            android:textStyle="bold"
            android:letterSpacing="0.05"
            android:contentDescription="Export Trajectory CSV"
            app:icon="@drawable/ic_share"
            app:iconTint="@color/fab_export_text"
            app:backgroundTint="@color/fab_export_bg"
            app:elevation="8dp" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
