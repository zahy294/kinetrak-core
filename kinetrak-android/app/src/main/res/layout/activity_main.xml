<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B0E14">

    <!-- Background Layer: Full-screen CameraX PreviewView -->
    <androidx.camera.view.PreviewView
        android:id="@+id/viewFinder"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- State Badge (Pinned to top-end) -->
    <TextView
        android:id="@+id/tvStateBadge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:layout_marginEnd="16dp"
        android:background="#00E5FF"
        android:elevation="6dp"
        android:paddingStart="14dp"
        android:paddingTop="10dp"
        android:paddingEnd="14dp"
        android:paddingBottom="10dp"
        android:text="IDLE"
        android:textColor="#000000"
        android:textSize="13sp"
        android:textStyle="bold"
        android:letterSpacing="0.05"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        tools:text="IDLE" />

    <!-- Foreground HUD: Pinned to top-start -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/hudCard"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="24dp"
        android:layout_marginEnd="12dp"
        app:cardCornerRadius="12dp"
        app:cardElevation="8dp"
        app:cardBackgroundColor="@color/hud_background"
        app:strokeColor="@color/hud_border"
        app:strokeWidth="1.5dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/tvStateBadge">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="KINETRAK TELEMETRY"
                android:textColor="@color/hud_text_accent"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.1" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="6dp"
                android:background="@color/hud_border" />

            <TextView
                android:id="@+id/tvTelemetrySeq"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SEQ: 0"
                android:textColor="#00E5FF"
                android:textSize="16sp"
                android:typeface="monospace"
                android:textStyle="bold"
                tools:text="SEQ: 1245" />

            <TextView
                android:id="@+id/tvTelemetryTracking"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="TRACKING: 1"
                android:textColor="#00FF66"
                android:textSize="14sp"
                android:typeface="monospace"
                android:textStyle="bold"
                tools:text="TRACKING: 1" />

            <TextView
                android:id="@+id/tvTelemetryPose"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="POS: [0.00, 0.00, 0.00]"
                android:textColor="@color/hud_text_secondary"
                android:textSize="11sp"
                android:typeface="monospace"
                tools:text="POS: [+0.12, -0.45, +0.89]" />

            <TextView
                android:id="@+id/tvTelemetryAction"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="ACTION: NULL"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:typeface="monospace"
                tools:text="ACTION: NULL" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Controls Container (Pinned to bottom of the screen) -->
    <HorizontalScrollView
        android:id="@+id/bottomControlsScroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="28dp"
        android:clipToPadding="false"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:scrollbars="none"
        android:overScrollMode="never"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:id="@+id/bottomControlsContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Saved Sessions Vault Button -->
            <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
                android:id="@+id/btnSavedSessions"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="12dp"
                android:text="SAVED SESSIONS"
                android:textColor="@color/hud_text_accent"
                android:textStyle="bold"
                android:letterSpacing="0.05"
                android:contentDescription="Saved Sessions Spatial Vault"
                app:icon="@drawable/ic_vault"
                app:iconTint="@color/hud_text_accent"
                app:backgroundTint="@color/card_dark_bg"
                app:strokeColor="@color/hud_border"
                app:strokeWidth="1.5dp"
                app:elevation="8dp" />

            <!-- Tracking Toggle Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnToggleTracking"
                android:layout_width="wrap_content"
                android:layout_height="56dp"
                android:layout_marginEnd="12dp"
                android:text="START TRACKING"
                android:textColor="#000000"
                android:textSize="13sp"
                android:textStyle="bold"
                android:letterSpacing="0.05"
                app:cornerRadius="28dp"
                app:backgroundTint="#00FF66"
                app:elevation="8dp" />

            <!-- Mic Toggle Floating Action Button (Voice Trigger) -->
            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/fabMicToggle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="12dp"
                android:contentDescription="Voice Trigger Toggle"
                android:src="@drawable/ic_mic"
                app:backgroundTint="@color/fab_mic_idle"
                app:tint="@color/white"
                app:fabSize="normal"
                app:elevation="8dp" />

            <!-- Export Trajectory Extended Floating Action Button -->
            <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
                android:id="@+id/fabExport"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="EXPORT TRAJECTORY"
                android:textColor="@color/fab_export_text"
                android:textStyle="bold"
                android:letterSpacing="0.05"
                android:contentDescription="Export Trajectory CSV"
                app:icon="@drawable/ic_share"
                app:iconTint="@color/fab_export_text"
                app:backgroundTint="@color/fab_export_bg"
                app:elevation="8dp" />
        </LinearLayout>
    </HorizontalScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
