<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B0E14">

    <!-- 3D OpenGL Surface View -->
    <android.opengl.GLSurfaceView
        android:id="@+id/glTrajectoryView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Top Overlay Header Card -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/topOverlayCard"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="16dp"
        app:cardCornerRadius="12dp"
        app:cardElevation="10dp"
        app:cardBackgroundColor="@color/hud_background"
        app:strokeColor="@color/hud_border"
        app:strokeWidth="1.5dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="14dp">

            <!-- Title Row with Close and Share buttons -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvPlaybackTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="monospace"
                    android:letterSpacing="0.05"
                    android:text="3D SPATIAL TRAJECTORY"
                    android:textColor="@color/hud_text_accent"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <!-- Share to PC Button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSharePlayback"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginEnd="8dp"
                    android:letterSpacing="0.05"
                    android:text="SHARE TO PC"
                    android:textColor="@color/black"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    app:backgroundTint="@color/badge_idle_cyan"
                    app:cornerRadius="18dp"
                    app:icon="@drawable/ic_laptop"
                    app:iconGravity="textStart"
                    app:iconPadding="4dp"
                    app:iconSize="14dp"
                    app:iconTint="@color/black" />

                <!-- Close Button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnClosePlayback"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:padding="0dp"
                    android:insetLeft="0dp"
                    android:insetTop="0dp"
                    android:insetRight="0dp"
                    android:insetBottom="0dp"
                    app:backgroundTint="#30363D"
                    app:cornerRadius="18dp"
                    app:icon="@drawable/ic_close"
                    app:iconGravity="textStart"
                    app:iconPadding="0dp"
                    app:iconSize="18dp"
                    app:iconTint="@color/white" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvPlaybackSessionId"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="monospace"
                android:text="session_demo_baseline"
                android:textColor="@color/hud_text_primary"
                android:textSize="12sp"
                tools:text="session_20260905_231500" />

            <!-- Stats Row: Path Length, Samples, Action Badge -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvPlaybackLength"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@color/badge_idle_bg"
                    android:fontFamily="monospace"
                    android:paddingStart="8dp"
                    android:paddingTop="4dp"
                    android:paddingEnd="8dp"
                    android:paddingBottom="4dp"
                    android:text="TAU: 1.14 | LEN: 0.82m"
                    android:textColor="@color/hud_text_secondary"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    tools:text="TAU: 1.14 | LEN: 0.82m" />

                <TextView
                    android:id="@+id/tvPlaybackSamples"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@color/badge_idle_bg"
                    android:fontFamily="monospace"
                    android:paddingStart="8dp"
                    android:paddingTop="4dp"
                    android:paddingEnd="8dp"
                    android:paddingBottom="4dp"
                    android:text="48 pts"
                    android:textColor="@color/hud_text_secondary"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    tools:text="48 pts" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/tvPlaybackAction"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@color/badge_action_neon_green"
                    android:fontFamily="monospace"
                    android:paddingStart="10dp"
                    android:paddingTop="4dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="4dp"
                    android:text="ACTION:SPAWN"
                    android:textColor="@color/black"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    tools:text="ACTION:SPAWN" />
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Bottom Scrubber & Hint Controls -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/bottomScrubberCard"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="24dp"
        app:cardCornerRadius="12dp"
        app:cardElevation="10dp"
        app:cardBackgroundColor="@color/hud_background"
        app:strokeColor="@color/hud_border"
        app:strokeWidth="1.5dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="monospace"
                    android:text="TIMELINE SCRUBBER"
                    android:textColor="@color/hud_text_accent"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvScrubProgress"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:text="48 / 48 (100%)"
                    android:textColor="@color/hud_text_secondary"
                    android:textSize="11sp"
                    tools:text="48 / 48 (100%)" />
            </LinearLayout>

            <SeekBar
                android:id="@+id/seekBarScrub"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:max="100"
                android:progress="100"
                android:progressTint="@color/badge_action_neon_green"
                android:thumbTint="@color/badge_idle_cyan" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="4dp"
                android:fontFamily="monospace"
                android:text="Drag: Orbit 3D Path | Pinch: Zoom"
                android:textColor="@color/text_muted"
                android:textSize="10sp" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>
